{
  "name": "Event",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "Reference to accepted proposal"
    },
    "venue_id": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_email": {
      "type": "string"
    },
    "bar_owner_email": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "performance_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "venue_id",
    "artist_profile_id",
    "event_date"
  ]
}