{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "Chat linked to a proposal"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "proposal_id",
    "sender_email",
    "receiver_email",
    "content"
  ]
}