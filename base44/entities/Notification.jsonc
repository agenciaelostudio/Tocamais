{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "proposal",
        "tip",
        "review",
        "event",
        "system"
      ],
      "default": "system"
    },
    "link": {
      "type": "string",
      "description": "Optional link to navigate to"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "title",
    "message"
  ]
}